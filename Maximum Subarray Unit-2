class Solution {
    public int maxSubArray(int[] nums) {
        int cursum = nums[0];
        int maxsum = nums[0];
        for(int i=1;i<nums.length;i++){
            cursum=Math.max(nums[i],cursum+nums[i]);
            maxsum=Math.max(cursum,maxsum);
        }
        return maxsum;
    }
}

Input
nums = [-2,1,-3,4,-1,2,1,-5,4]
Output
6
Expected Output
6
