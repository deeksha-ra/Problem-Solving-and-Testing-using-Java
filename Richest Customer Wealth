import java.util.*;
class Solution {
    public int maximumWealth(int[][] accounts) {
        int[] sum = new int[5];
        for(int i=0;i<accounts.length;i++){
            for(int j=0;j<accounts[i].length;j++){
                sum[i]+=accounts[i][j];
            }
        }
        int maxsum=sum[0];
        for(int i=1;i<sum.length;i++){
            if(maxsum<sum[i]){
                maxsum=sum[i];
            }
        }
        return maxsum;
    }
}
