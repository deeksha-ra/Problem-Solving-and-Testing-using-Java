class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {
        return new ArrayList<>(
                Arrays.stream(strs)
                      .collect(Collectors.groupingBy(s -> {
                          char[] ch = s.toCharArray();
                          Arrays.sort(ch);
                          return new String(ch);
                      }))
                      .values()
        );
    }
}
