import java.util.Scanner;
import java.util.Arrays;
public class Sts{
  public static void main(String[] args){
    Scanner sc=new Scanner(System.in);
    int n=sc.nextInt();
    int[] sal=new int[n];
    Arrays.setAll(sal,i->sc.nextInt());
    Arrays.stream(sal)
          .map(a->a+(a*10/100))
          .forEach(System.out::println);
    sc.close();
  }
}
